#!/bin/sh
# Build a validated, self-contained local review ZIP without publishing it.
set -eu

cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
Usage: ./script/create-preview-bundle [ABSOLUTE_OUTPUT_PATH]

Build and check the local site, then create a private review ZIP.
Without an output path, the ZIP is timestamped and written to /tmp.
The output directory must exist, and the ZIP must not already exist.
EOF
}

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi
case "${1-}" in
  -h|--help) usage; exit 0 ;;
esac

output=${1:-"/tmp/autodial-review-preview-$(date +%Y%m%d-%H%M%S).zip"}
case "$output" in
  /*) ;;
  *) echo "Choose an absolute output path." >&2; exit 2 ;;
esac
if [ ! -d "$(dirname "$output")" ]; then
  echo "Output directory does not exist: $(dirname "$output")" >&2
  exit 2
fi
if [ -e "$output" ]; then
  echo "Output already exists: $output" >&2
  exit 2
fi
if ! command -v zip >/dev/null 2>&1; then
  echo "zip is required to create the review bundle." >&2
  exit 2
fi

make check

bundle_dir=$(mktemp -d)
trap 'rm -rf "$bundle_dir"' EXIT
mkdir "$bundle_dir/site"
cp -R _site/. "$bundle_dir/site/"
rm -f "$bundle_dir/site/CNAME"
cp script/serve-preview.py "$bundle_dir/serve-preview.py"
cat > "$bundle_dir/README.txt" <<'EOF'
AutoDIAL website draft — local review copy

This is a provisional research-group website draft. It has not been reviewed
or approved by the PI. Please share feedback privately; do not upload this ZIP
or its extracted files to a public website.

To view it:
1. Extract the entire ZIP into a folder.
2. Open a terminal in that folder.
3. On macOS or Linux, run: python3 serve-preview.py
   On Windows, run: python serve-preview.py (or py serve-preview.py)
4. Open http://127.0.0.1:8000/ in your browser.
5. Press Ctrl-C in the terminal when finished.

Python 3.9 or newer is required. The server listens only on your own computer.
Do not open site/index.html directly: page links need the local server.
External links, including AutoEIS documentation and publication DOIs, require
internet access and lead outside this preview.

Send feedback with the page URL, screen size/device, and a screenshot if useful.
EOF

(cd "$bundle_dir" && zip -qr "$output" README.txt serve-preview.py site)
printf 'Review bundle: %s\n' "$output"
python3 - "$output" <<'PY'
import hashlib
import sys

digest = hashlib.sha256()
with open(sys.argv[1], "rb") as archive:
    for chunk in iter(lambda: archive.read(1024 * 1024), b""):
        digest.update(chunk)
print(f"SHA-256: {digest.hexdigest()}")
PY
